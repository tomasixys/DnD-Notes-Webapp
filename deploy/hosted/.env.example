# Generate both values before starting. Use hexadecimal values so the
# PostgreSQL password is safe to embed in a database URL.
DND_NOTES_POSTGRES_PASSWORD=replace-with-at-least-32-random-hex-characters
DND_NOTES_SESSION_SECRET=replace-with-at-least-64-random-hex-characters

# Host ports may be changed when 80 or 443 are already occupied.
DND_NOTES_HTTP_PORT=80
DND_NOTES_HTTPS_PORT=443
